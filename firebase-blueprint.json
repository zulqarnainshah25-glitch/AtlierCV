{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Stores user account metadata, role-based access level, subscription plan, and export counters.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the user",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address (PII isolated to owner and admin)",
          "minLength": 3,
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "description": "Full name of the user",
          "minLength": 1,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["user", "admin"],
          "description": "Access control role"
        },
        "plan": {
          "type": "string",
          "enum": ["free", "premium"],
          "description": "Subscription tier"
        },
        "pdfExportsUsed": {
          "type": "integer",
          "description": "Number of PDF exports used by the user"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["uid", "email", "displayName", "role", "plan", "pdfExportsUsed", "createdAt", "updatedAt"]
    },
    "CVDocument": {
      "title": "CVDocument",
      "description": "Complete user CV document including raw inputs, AI-polished sections, cropped photo, and selected template.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "templateId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "jobTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 254
        },
        "phone": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40
        },
        "address": {
          "type": "string",
          "maxLength": 250
        },
        "linkedinUrl": {
          "type": "string",
          "maxLength": 300
        },
        "portfolioUrl": {
          "type": "string",
          "maxLength": 300
        },
        "photoDataUrl": {
          "type": "string",
          "maxLength": 750000
        },
        "rawSummary": {
          "type": "string",
          "maxLength": 4000
        },
        "summary": {
          "type": "string",
          "maxLength": 4000
        },
        "experience": {
          "type": "array",
          "description": "Bounded list (max 25) of work experience entries with bullets"
        },
        "education": {
          "type": "array",
          "description": "Bounded list (max 20) of education entries"
        },
        "skills": {
          "type": "array",
          "description": "Bounded list (max 60) of skill tags"
        },
        "skillGroups": {
          "type": "array",
          "description": "Bounded list (max 15) of categorized skill groups"
        },
        "projects": {
          "type": "array",
          "description": "Bounded list (max 20) of project entries"
        },
        "languages": {
          "type": "array",
          "description": "Bounded list (max 20) of languages"
        },
        "certifications": {
          "type": "array",
          "description": "Bounded list (max 20) of certifications"
        },
        "isPolished": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "title",
        "templateId",
        "fullName",
        "jobTitle",
        "email",
        "phone",
        "address",
        "linkedinUrl",
        "portfolioUrl",
        "photoDataUrl",
        "rawSummary",
        "summary",
        "experience",
        "education",
        "skills",
        "skillGroups",
        "projects",
        "languages",
        "certifications",
        "isPolished",
        "createdAt",
        "updatedAt"
      ]
    },
    "CVTemplate": {
      "title": "CVTemplate",
      "description": "JSON/CSS configuration and photoSlot specification for a CV layout template.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "category": {
          "type": "string",
          "enum": ["Modern", "Classic", "Minimal", "Creative", "Executive", "ATS-friendly"]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "isPremium": {
          "type": "boolean"
        },
        "accentColor": {
          "type": "string",
          "minLength": 3,
          "maxLength": 32
        },
        "secondaryColor": {
          "type": "string",
          "minLength": 3,
          "maxLength": 32
        },
        "fontFamily": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "layoutType": {
          "type": "string",
          "enum": [
            "two-column-left",
            "two-column-right",
            "single-column-classic",
            "minimal-editorial",
            "creative-split",
            "ats-clean"
          ]
        },
        "photoSlot": {
          "type": "object",
          "description": "Defines position and 35x45mm aspect ratio slot for user photo"
        },
        "customCss": {
          "type": "string",
          "maxLength": 5000
        },
        "thumbnailType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "category",
        "description",
        "isPremium",
        "accentColor",
        "secondaryColor",
        "fontFamily",
        "layoutType",
        "photoSlot",
        "customCss",
        "thumbnailType",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted marker document for elevated admin privileges.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 254
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile and subscription tier records, isolated per user or admin."
    },
    "/cvs/{cvId}": {
      "schema": { "$ref": "#/entities/CVDocument" },
      "description": "User CV documents with auto-save and offline persistence support."
    },
    "/templates/{templateId}": {
      "schema": { "$ref": "#/entities/CVTemplate" },
      "description": "CV template configurations readable by authenticated users and editable by admins."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Admin directory used by security rules to verify administrator privileges."
    }
  }
}
