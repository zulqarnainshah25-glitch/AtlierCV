# GEMINI_API_KEY: Optional fallback AI key injected at runtime by AI Studio.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GROQ_API_KEY: Required for Groq API calls (model: llama-3.3-70b-versatile).
# Configure this in your server secrets / .env file. Never expose to frontend.
GROQ_API_KEY="gsk_your_groq_api_key_here"

# STRIPE_SECRET_KEY: Stripe test mode secret key for Premium Checkout sessions.
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key_here"

# STRIPE_WEBHOOK_SECRET: Stripe webhook signing secret for payment verification.
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret_here"

# STRIPE_PRICE_ID: Optional Stripe Price ID for Premium plan (defaults to inline price_data if omitted).
STRIPE_PRICE_ID=""

# FIREBASE CONFIG (also loaded from firebase-applet-config.json)
VITE_FIREBASE_API_KEY="your_firebase_api_key"
VITE_FIREBASE_AUTH_DOMAIN="your_project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your_project_id"
VITE_FIREBASE_STORAGE_BUCKET="your_project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your_messaging_sender_id"
VITE_FIREBASE_APP_ID="your_app_id"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="your_firestore_database_id"
